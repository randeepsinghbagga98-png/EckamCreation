{
  "name": "eckamcreation",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "EckamCreation — premium multi-category e-commerce platform (environment foundation)",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @eckamcreation/web dev",
    "dev:web": "pnpm --filter @eckamcreation/web dev",
    "dev:admin": "pnpm --filter @eckamcreation/admin dev",
    "dev:api": "pnpm --filter @eckamcreation/api dev",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "start": "pnpm --filter @eckamcreation/web start",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@eckamcreation/config": "workspace:*",
    "@eckamcreation/ui": "workspace:*",
    "@playwright/test": "^1.55.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
