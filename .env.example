# EckamCreation environment placeholders.
# Copy to .env.local for local development. Never commit real values.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EckamCreation

# Database / cache
# Local PostgreSQL example shape only (replace USER, PASSWORD, DB):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eckamcreation?schema=public
DATABASE_URL=
REDIS_URL=

# API (apps/api on port 3002)
# Comma-separated browser origins for CORS. Empty uses localhost:3000/3001 in development.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Max JSON body size in bytes (default 1048576 = 1 MiB)
API_JSON_BODY_LIMIT_BYTES=1048576

# Auth.js / NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# AI (server-side only)
AI_API_KEY=
AI_API_BASE_URL=

# Email (server-side only)
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp Business API (server-side only)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Payments (server-side only)
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=

# Object storage / CDN (server-side only)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
