# EckamCreation environment placeholders.
# Copy to .env.local for local development. Never commit real values.

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=EckamCreation

# Database / cache
# Local PostgreSQL example shape only (replace USER, PASSWORD, DB):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/eckamcreation?schema=public
DATABASE_URL=
REDIS_URL=

# API (apps/api on port 3002)
# Internal origin used by the storefront rewrite/proxy. Production must set this.
API_INTERNAL_URL=http://127.0.0.1:3002
# Comma-separated browser origins for CORS. Empty uses localhost:3000/3001 in development.
# Production must set explicit origins. Do not leave this empty in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Max JSON body size in bytes (default 1048576 = 1 MiB). Enforced in parseJsonBody.
API_JSON_BODY_LIMIT_BYTES=1048576

# Auth.js / NextAuth
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Admin bootstrap (server-side only). Used only when no ACTIVE staff users exist.
# Never add NEXT_PUBLIC_ADMIN_* credential variables.
ADMIN_EMAIL=admin@eckam.com
ADMIN_PASSWORD=12345

# AI (server-side only). Never expose these to the browser.
# Do not add NEXT_PUBLIC_AI_* keys.
# Set AI_PROVIDER=openai to use the official OpenAI adapter.
# Leave AI_PROVIDER empty in development/test to keep the local development adapter.
# Production requires an explicit AI_PROVIDER. There is no silent fallback.
# If AI_PROVIDER=openai and AI_API_KEY or AI_MODEL is absent, the API returns a controlled 503.
# AI conversation/message rate limits are enforced in PostgreSQL (10 conversations / 30 messages per 15 minutes per user).
# Redis is not required for those AI limits. REDIS_URL remains reserved for shared auth/cart limiter later.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_API_BASE_URL=

# Email (server-side only)
EMAIL_API_KEY=
EMAIL_FROM=

# WhatsApp Business API (server-side only)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# Payments (server-side only — never expose to the browser)
# WAITING FOR CLIENT PROVIDER SELECTION. Leave empty until a real provider is chosen.
# Do not add placeholder, fake, or sandbox credentials here.
# See docs/payment-provider.md
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
# Test adapter only. Never set in production. Allowed value: 1
ALLOW_TEST_PAYMENT_PROVIDER=

# Object storage / CDN (server-side only)
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=
STORAGE_REGION=
