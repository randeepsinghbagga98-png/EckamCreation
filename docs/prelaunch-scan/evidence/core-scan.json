    {
      "id": "F-S1-001",
      "title": "Invalid product slug does not return HTTP 404",
      "category": "routes",
      "severity": "P2",
      "evidence_type": "MEASURED",
      "problem": "Unknown product slug should be a proper 404.",
      "evidence": "GET /shop/qa-scan-unknown-slug-zzz -> 200",
      "location": "apps/web /shop/[slug]",
      "impact": "SEO and crawlers may index not-found as 200.",
      "suggested_fix": "Ensure notFound() results in HTTP 404 in the running Next mode.",
      "dev_only": false,
      "intentional_limitation": false
    },
    {
      "id": "F-S1-002",
